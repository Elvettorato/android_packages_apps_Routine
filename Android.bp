package {
    default_applicable_licenses: ["packages_apps_Routine_license"],
}

license {
    name: "packages_apps_Routine_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

android_app {
    name: "Routine",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    resource_dirs: ["res"],

    sdk_version: "system_current",
    product_specific: true,
    privileged: true,
    certificate: "platform",

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.activity_activity-ktx",
        "androidx.fragment_fragment-ktx",
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "androidx.lifecycle_lifecycle-livedata-ktx",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.constraintlayout_constraintlayout",
        "androidx.work_work-runtime",
        "androidx.work_work-runtime-ktx",
        "com.google.android.material_material",
        "kotlinx-coroutines-core",
        "kotlinx-coroutines-android",
    ],

    required: [
        "privapp_whitelist_com.elvettorato.routine",
        "preinstalled-packages-com.elvettorato.routine.xml",
    ],

    kotlincflags: [
        "-Xjvm-default=all",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.elvettorato.routine",
    sub_dir: "permissions",
    src: "etc/permissions/privapp-permissions-com.elvettorato.routine.xml",
    filename_from_src: true,
    product_specific: true,
}

prebuilt_etc {
    name: "preinstalled-packages-com.elvettorato.routine.xml",
    sub_dir: "sysconfig",
    src: "etc/sysconfig/preinstalled-packages-com.elvettorato.routine.xml",
    filename_from_src: true,
    product_specific: true,
}
