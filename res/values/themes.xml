<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 Expressive base. We inherit from the AppCompat DayNight
         bridge so SettingsLib widgets used by privileged system apps render
         consistently with the LineageOS 23.2 Settings UI. Dynamic Monet colors
         are picked up automatically at runtime via the android.* system color
         resources referenced below. -->
    <style name="Theme.Routine" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:enforceStatusBarContrast">true</item>

        <item name="colorPrimary">?android:attr/colorAccent</item>
        <item name="colorOnPrimary">@android:color/system_on_primary_light</item>
        <item name="colorPrimaryContainer">@android:color/system_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@android:color/system_on_primary_container_light</item>
        <item name="colorSecondaryContainer">@android:color/system_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@android:color/system_on_secondary_container_light</item>
        <item name="colorSurface">@android:color/system_surface_light</item>
        <item name="colorSurfaceContainer">@android:color/system_surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@android:color/system_surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@android:color/system_surface_container_highest_light</item>
        <item name="colorOnSurface">@android:color/system_on_surface_light</item>
        <item name="colorOnSurfaceVariant">@android:color/system_on_surface_variant_light</item>
        <item name="colorOutline">@android:color/system_outline_light</item>
        <item name="colorOutlineVariant">@android:color/system_outline_variant_light</item>

        <item name="materialThemeOverlay">@style/ThemeOverlay.Routine.Expressive</item>

        <item name="floatingActionButtonStyle">@style/Widget.Routine.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Routine.ExtendedFloatingActionButton</item>
        <item name="materialCardViewStyle">@style/Widget.Routine.CardView</item>
        <item name="toolbarStyle">@style/Widget.Routine.Toolbar</item>
    </style>

    <style name="ThemeOverlay.Routine.Expressive" parent="">
        <!-- Larger corner radii like the Material 3 Expressive "wavy" components -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Routine.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Routine.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Routine.Large</item>
    </style>

    <style name="ShapeAppearance.Routine.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Routine.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Routine.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Routine.FloatingActionButton"
           parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Routine.Fab</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="ShapeAppearance.Routine.Fab" parent="">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Routine.ExtendedFloatingActionButton"
           parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Routine.Fab</item>
    </style>

    <style name="Widget.Routine.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="rippleColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Routine.Toolbar" parent="Widget.Material3.Toolbar.OnSurface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Routine.Toolbar.Title</item>
    </style>

    <style name="TextAppearance.Routine.Toolbar.Title"
           parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Routine.RoutineName"
           parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Routine.RoutineSummary"
           parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
